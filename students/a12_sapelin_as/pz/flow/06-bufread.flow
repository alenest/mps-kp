# Чтение отсчёта из кольцевого буфера (BufRead)
начало: BufRead
если: F_EMPTY = 1?
  да:
    действие: A := 0
  нет:
    действие: Сохранить B; DPTR := TAIL
    данные: B := ячейка DPTR
    действие: DPTR := DPTR + 1
    если: DPTR = BUF_END?
      да:
        действие: DPTR := BUF_START
    действие: TAIL := DPTR; F_OVF := 0; F_EMPTY := 0
    если: TAIL = HEAD?
      да:
        действие: F_EMPTY := 1
    действие: A := B; восстановить B
конец: Возврат (A — результат)
